# Local demo is entirely fictional; never expose demo to the network.
DATA_MODE=demo
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://127.0.0.1:3001

# Generate and store a strong random secret locally (at least 32 characters).
# Blank is allowed ONLY for local demo and generates an ephemeral startup secret.
# Example generation: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
USERS_FILE=server/config/users.json
CACHE_DIR=server/private/cache
SESSION_DIR=server/private/sessions

# For live mode set DATA_MODE=sheets and supply all fields below.
# Use the ID only, not the spreadsheet URL.
GOOGLE_SPREADSHEET_ID=
# Absolute private path recommended, outside public/, dist/, src/ and ideally the repo.
# Example: C:/Users/your-user/private/marketing-service-account.json
GOOGLE_SERVICE_ACCOUNT_FILE=

# Production also requires NODE_ENV=production and APP_ORIGIN=https://your-domain.
# For an HTTPS reverse proxy on this same host ONLY, explicitly set this to loopback.
# Otherwise leave blank; never use true or a hop count.
TRUST_PROXY=
